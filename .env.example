# Gemini: get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Supabase: Project Settings -> API (server-side only, never expose the service role key)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Solana (devnet)
SOLANA_RPC_URL=https://api.devnet.solana.com
# The wallet that receives everyone's payments (the host's Phantom address)
MERCHANT_WALLET=
# Filled in by `npm run devnet init`
SPLIT_TOKEN_MINT=
# For the one-tap Pay button. Get it with `npm run devnet export-admin`. Never share it.
ADMIN_SECRET_KEY=

# ElevenLabs voice announcements on the live bill (optional). Key from elevenlabs.io → Developers → API Keys.
ELEVENLABS_API_KEY=
# Optional: pick a voice from your ElevenLabs Voices page (defaults to a built-in voice)
ELEVENLABS_VOICE_ID=
